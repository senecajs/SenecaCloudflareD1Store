{
  "name": "@seneca/cloudflare-d1-store",
  "version": "0.1.0",
  "description": "Seneca Cloudflare D1 Store data storage plugin.",
  "main": "dist/CloudflareD1Store.js",
  "type": "commonjs",
  "types": "dist/CloudflareD1Store.d.ts",
  "license": "MIT",
  "author": "Richard Rodger (http://richardrodger.com)",
  "contributors": [
    "Richard Rodger (http://richardrodger.com)"
  ],
  "scripts": {
    "test": "jest --coverage",
    "test-some": "jest -t",
    "test-watch": "jest --coverage --watchAll",
    "watch": "tsc -w -d",
    "build": "tsc -d",
    "prepack": "npm run build",
    "prettier": "prettier --write --no-semi --single-quote src/**/*.ts test/**/*.ts",
    "reset": "npm run clean && npm i && npm run build && npm test",
    "clean": "rm -rf node_modules dist package-lock.json yarn.lock"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senecajs/SenecaCloudflareD1Store.git"
  },
  "keywords": [
    "seneca",
    "plugin",
    "store",
    "cloudflare",
    "d1",
    "sqlite",
    "sql"
  ],
  "peerDependencies": {
    "@seneca/entity": "^29.0.0",
    "seneca": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260615.1",
    "@seneca/entity": "^29.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.0",
    "esbuild": "^0.20.1",
    "esbuild-jest": "^0.5.0",
    "jest": "^29.7.0",
    "miniflare": "^4.20260611.0",
    "prettier": "^3.2.5",
    "seneca": "^4.0.0",
    "typescript": "^5.3.3"
  },
  "files": [
    "README.md",
    "CHANGES.md",
    "LICENSE",
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
